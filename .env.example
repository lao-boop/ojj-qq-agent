# 环境变量示例
# 复制为 .env 并不是本项目必需（配置走 config.json），
# 这里列出所有支持的覆盖项，方便容器/CI 部署。

# DeepSeek
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1

# Replicate（出图 / 写歌 / 变声 / 云端 ASR）
REPLICATE_API_TOKEN=

# OneBot
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_TOKEN=

# 汽修评测数据集目录
AUTOREPAIR_DIR=

# 本地 Python / ffmpeg
PYTHON_PATH=
FFMPEG_PATH=
