# 环境变量示例
# 可复制为 .env；环境变量会覆盖 config.json 中对应配置。
# 密钥请留在本机 .env 或部署平台的密钥设置中。

# 接入平台：qq 或 wecom（默认 qq）
CHAT_PLATFORM=qq

# 企业微信：智能机器人 → API 模式 → 使用长连接
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Replicate（出图 / 写歌 / 变声 / 云端 ASR）
REPLICATE_API_TOKEN=

# OneBot
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=

# 本地控制台访问令牌
CONSOLE_TOKEN=

# 汽修评测数据集目录
AUTOREPAIR_DIR=

# 本地 Python / ffmpeg
PYTHON_PATH=
FFMPEG_PATH=
