{
  "name": "qq-bot-whale",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "小鲸鱼：企业微信 AI 秘书与 QQ 聊天机器人，支持原文追溯、定时汇报和本地控制台",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/start.js",
    "start:qq": "node src/index.js",
    "start:wecom": "node src/wecom-main.js",
    "test:wecom": "node --test test/*.test.js",
    "mock": "node src/mock-onebot.js",
    "test:e2e": "node scripts/e2e.js",
    "test": "node --test test/*.test.js",
    "check:release": "node scripts/sync-wecom-manifest.mjs",
    "manifest:sync": "node scripts/sync-wecom-manifest.mjs --write",
    "test:secretary": "node scripts/iterate-secretary.mjs --v3 --full",
    "experiment:secretary": "node scripts/experiment-secretary.mjs --algorithm upgraded --history-mode fixture --request-timeout-ms 60000 --request-attempts 1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@wecom/aibot-node-sdk": "1.0.7",
    "https-proxy-agent": "7.0.6",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "opencc-js": "^1.4.2",
    "proxy-from-env": "2.1.0",
    "ws": "^8.18.0"
  }
}
